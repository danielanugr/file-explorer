{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "migrate": "bun src/db/migrate.ts",
    "seed": "bun src/db/seed.ts",
    "db:setup": "bun run migrate && bun run seed",
    "test:api": "bun src/test-api.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:seed": "bun src/db/drizzleSeed.ts",
    "drizzle:setup": "bun run drizzle:migrate && bun run drizzle:seed",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "elysia": "latest",
    "pg": "^8.11.0",
    "@elysiajs/cors": "latest",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.10.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.0.0"
  }
}